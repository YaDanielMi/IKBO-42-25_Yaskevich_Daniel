# Стартовый скрипт эмулятора: демонстрация этапов 1-2
# Строки с '#' — комментарии, они показываются, но не выполняются.
ls
ls -l "my dir" 'second arg'
cd /tmp   # комментарий в конце строки
ls a#b "#не комментарий"

# Ошибки не прерывают скрипт
foo --bar
ls "незакрытая кавычка
cd 'тоже незакрытая
exit 1 2

# Завершение
exit 7
